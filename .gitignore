# Dev tooling
node_modules/

# Generated cockpit page (rebuild with: node tools/build-cockpit.mjs)
cockpit/

# Eval sandboxes (temp folders created by tools/run-evals.mjs)
evals/**/sandbox/
.eval-sandbox*/

# Local-only Claude Code settings (e.g. Superpowers, added per project when a change needs it)
.claude/settings.local.json

# Worktrees for builds whose Safeguards choose one (/kit:ready)
.claude/worktrees/

# Impeccable (tool; reinstall per clone: npx -y impeccable install --providers=claude --scope=project)
.claude/skills/impeccable/
.claude/agents/impeccable-*.md

# Impeccable decision-page scratch (session-local)
.impeccable/questions/

# Last passing smoke run (npm run smoke; read by npm run smoke:check)
.smoke-pass.json

# playwright-cli page snapshots (session-local)
.playwright-cli/

# Local word list and private trial notes (repo-privacy); never committed
.private-words
private/
